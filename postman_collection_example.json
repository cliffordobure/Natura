{
  "info": {
    "name": "Natura API",
    "description": "Complete API collection for Natura childcare management system",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api/v1",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@natura.com\",\n  \"password\": \"password123\",\n  \"firstName\": \"Admin\",\n  \"lastName\": \"User\",\n  \"phoneNumber\": \"+1234567890\",\n  \"role\": \"admin\",\n  \"schoolId\": \"SCHOOL_ID_HERE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "pm.collectionVariables.set('token', response.token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@natura.com\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "logout"]
            }
          }
        }
      ]
    },
    {
      "name": "Schools",
      "item": [
        {
          "name": "Get All Schools",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/schools",
              "host": ["{{baseUrl}}"],
              "path": ["schools"]
            }
          }
        },
        {
          "name": "Create School",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Natura Learning Center\",\n  \"address\": \"123 Main Street\",\n  \"city\": \"Springfield\",\n  \"state\": \"CA\",\n  \"zipCode\": \"12345\",\n  \"phoneNumber\": \"+1234567890\",\n  \"email\": \"info@natura.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/schools",
              "host": ["{{baseUrl}}"],
              "path": ["schools"]
            }
          }
        }
      ]
    },
    {
      "name": "Classrooms",
      "item": [
        {
          "name": "Get Classrooms",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/classrooms",
              "host": ["{{baseUrl}}"],
              "path": ["classrooms"]
            }
          }
        },
        {
          "name": "Create Classroom",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sunny Tots\",\n  \"schoolId\": \"SCHOOL_ID\",\n  \"description\": \"A warm environment\",\n  \"capacity\": 12,\n  \"ageGroup\": \"Infants (0-12 months)\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/classrooms",
              "host": ["{{baseUrl}}"],
              "path": ["classrooms"]
            }
          }
        }
      ]
    },
    {
      "name": "Children",
      "item": [
        {
          "name": "Get Children",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/children",
              "host": ["{{baseUrl}}"],
              "path": ["children"]
            }
          }
        },
        {
          "name": "Create Child",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Emma\",\n  \"lastName\": \"Johnson\",\n  \"dateOfBirth\": \"2023-01-01\",\n  \"gender\": \"female\",\n  \"classroomId\": \"CLASSROOM_ID\",\n  \"schoolId\": \"SCHOOL_ID\",\n  \"parentIds\": [\"PARENT_ID\"],\n  \"emergencyContact\": \"+1234567890\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/children",
              "host": ["{{baseUrl}}"],
              "path": ["children"]
            }
          }
        }
      ]
    },
    {
      "name": "Attendance",
      "item": [
        {
          "name": "Check In Child",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"childId\": \"CHILD_ID\",\n  \"classroomId\": \"CLASSROOM_ID\",\n  \"checkInNotes\": \"Had a good breakfast\",\n  \"temperature\": 98.6,\n  \"mood\": \"Happy\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/attendance/checkin",
              "host": ["{{baseUrl}}"],
              "path": ["attendance", "checkin"]
            }
          }
        },
        {
          "name": "Check Out Child",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"childId\": \"CHILD_ID\",\n  \"checkOutNotes\": \"Picked up on time\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/attendance/checkout",
              "host": ["{{baseUrl}}"],
              "path": ["attendance", "checkout"]
            }
          }
        },
        {
          "name": "Get Attendance",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/attendance?childId=CHILD_ID&date=2024-01-01",
              "host": ["{{baseUrl}}"],
              "path": ["attendance"],
              "query": [
                {
                  "key": "childId",
                  "value": "CHILD_ID"
                },
                {
                  "key": "date",
                  "value": "2024-01-01"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Activities",
      "item": [
        {
          "name": "Get Activities",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/activities?childId=CHILD_ID",
              "host": ["{{baseUrl}}"],
              "path": ["activities"],
              "query": [
                {
                  "key": "childId",
                  "value": "CHILD_ID"
                }
              ]
            }
          }
        },
        {
          "name": "Create Activity",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"childId\": \"CHILD_ID\",\n  \"classroomId\": \"CLASSROOM_ID\",\n  \"type\": \"meal\",\n  \"title\": \"Lunch\",\n  \"description\": \"Had a great lunch!\",\n  \"metadata\": {\n    \"mealType\": \"lunch\",\n    \"amount\": \"most\",\n    \"foodItems\": [\"Chicken\", \"Rice\", \"Broccoli\"]\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/activities",
              "host": ["{{baseUrl}}"],
              "path": ["activities"]
            }
          }
        }
      ]
    },
    {
      "name": "File Upload",
      "item": [
        {
          "name": "Upload Media",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/upload/media",
              "host": ["{{baseUrl}}"],
              "path": ["upload", "media"]
            }
          }
        }
      ]
    }
  ]
}

